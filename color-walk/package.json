{
  "name": "color-walk",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "build:index": "node scripts/color-index/build-color-index.mjs",
    "verify:index": "node scripts/color-index/verify-index.mjs",
    "deploy": "npm run build && wrangler pages deploy dist --project-name color-walk"
  },
  "dependencies": {
    "openseadragon": "6.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.2",
    "@types/openseadragon": "6.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "sharp": "0.35.4",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "5.0.0",
    "wrangler": "4.131.1"
  }
}
